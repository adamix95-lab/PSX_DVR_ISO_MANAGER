+// OSD override is active only in experimental neutrino_lang.elf with -osdlang=en.
+// Cache PS2 OSD settings in the EE core; do not call the BIOS setter from
+// game syscalls, so neither the PSX OSD nor NVRAM is changed permanently.
+static ConfigParam osd_cache;
+static void (*Old_SetOsdConfigParam)(ConfigParam *param);
+static void (*Old_GetOsdConfigParam)(ConfigParam *param);
+
+static void Hook_SetOsdConfigParam(ConfigParam *param)
+{
+    if (!param)
+        return;
+    osd_cache = *param;
+    osd_cache.language = LANGUAGE_ENGLISH;
+    osd_cache.japLanguage = 1;
+}
+
+static void Hook_GetOsdConfigParam(ConfigParam *param)
+{
+    if (param)
+        *param = osd_cache;
+}
