@@ -723,6 +732,13 @@
      * **********************************************************************
      */
 
+    /* Do not alter non-DVR or quick-boot device state. */
+    if (desr_quitgame_requested &&
+        (strcmp(sys.sBSD, "dvr") != 0 || sys.bQuickBoot != 0)) {
+        printf("ERROR: -quitgame=1 requires -bsd=dvr and normal boot\n");
+        return -1;
+    }
+
     if (sys.bQuickBoot == 0) {
         /*
          * Reboot IOP into Load Environment (LE)
@@ -745,6 +761,31 @@
             uint8_t in[4] = {0};
             uint8_t out[16] = {};
             sceCdApplySCmd(0x29, in, 4, out);
+
+            /* Mode 0 is needed for DVR access. The separate mode-1
+             * notification enables the physical QUIT GAME switch.
+             * Hardware test required: mode 1 might prevent later ISO reads.
+             * Send BEFORE resetting IOP/opening any DVR ISO handle. */
+            if (desr_quitgame_requested) {
+                uint8_t quit_in[4] = {1, 0, 0, 0};
+                uint8_t quit_out[16] = {0};
+                int notice_ok = 0;
+                for (int attempt = 0; attempt < 5; attempt++) {
+                    memset(quit_out, 0, sizeof(quit_out));
+                    if (sceCdApplySCmd(0x29, quit_in, sizeof(quit_in), quit_out) &&
+                        !(quit_out[0] & 0x80)) {
+                        notice_ok = 1;
+                        break;
+                    }
+                    usleep(20000);
+                }
+                if (!notice_ok) {
+                    printf("ERROR: QUIT GAME notice(1) failed; aborting test\n");
+                    sceCdInit(SCECdEXIT);
+                    return -1;
+                }
+                printf("DESR: QUIT GAME notice(1) accepted (experimental)\n");
+            }
             sceCdInit(SCECdEXIT);
         }
 
