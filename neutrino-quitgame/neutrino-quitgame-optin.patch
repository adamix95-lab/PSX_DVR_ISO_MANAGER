+static int desr_quitgame_requested = 0;
 
 void print_usage()
 {
@@ -131,6 +134,8 @@
     printf("  -cwd=<path>       Change working directory\n");
     printf("\n");
     printf("  -cfg=<file>       Load extra user/game specific config file (without .toml extension)\n");
+    printf("  -quitgame=1       EXPERIMENTAL DESR: enable front-panel QUIT GAME\n");
