     printf("\n");
     printf("  -dbc              Enable debug colors\n");
     printf("  -logo             Enable logo (adds rom0:PS2LOGO to arguments)\n");
@@ -193,6 +198,10 @@
             sys.eecore.osdlang_mode = 1;
         else if (!strcmp(argv[i], "-osdlang=system"))
             sys.eecore.osdlang_mode = 0;
+        else if (!strcmp(argv[i], "-quitgame=1"))
+            desr_quitgame_requested = 1;
